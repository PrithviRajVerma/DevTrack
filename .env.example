# ==============================================================================
# DevTrack Environment Configuration Template
# Copy this file to .env and adjust values for your environment.
# Never commit the .env file to version control.
# ==============================================================================

# Database Settings
DB_HOST=localhost
DB_PORT=5432
DB_NAME=devtrack
DB_USER=postgres
DB_PASSWORD=postgres

# Server Settings
SERVER_PORT=8080
BACKEND_PORT=8080
FRONTEND_PORT=80

# Security / JWT Settings (Use a secure, randomly generated 256-bit secret in production)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000
COOKIE_SECURE=false # Set to true when deploying with HTTPS/TLS

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://localhost:3000,http://localhost:5173


