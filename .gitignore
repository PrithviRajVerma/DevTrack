# Git ignore for DevTrack project

# Environment variables and secrets
.env
.env.local
*.env

# Operating System files
.DS_Store
Thumbs.db

# IDE and Editor files
.idea/
.vscode/
*.iml
*.iws
*.ipr
.settings/
.project
.classpath

# Backend (Maven / Java)
backend/target/
backend/.mvn/wrapper/maven-wrapper.jar
*.class
*.log

# Frontend (Node / Vite)
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/*.local
frontend/.eslintcache

# Logs
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
